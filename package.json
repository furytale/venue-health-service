{
  "name": "venue-health-service",
  "version": "1.0.0",
  "private": true,
  "overrides": { "multer": "^2.5.0" },
  "engines": { "node": ">=22.14.0" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/src/main.js",
    "dev": "tsx src/main.ts",
    "test": "tsx --test tests/*.test.ts",
    "fake:downstream": "tsx tools/fake-downstream.ts",
    "recover": "tsx src/recover.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "better-sqlite3": "^12.4.0",
    "express": "^5.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
