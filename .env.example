PORT=3000
SQLITE_PATH=./data/venue-health.sqlite
SQLITE_BUSY_TIMEOUT_MS=1000
STORAGE_RETRY_DELAY_MS=1000
DOWNSTREAM_URL=http://127.0.0.1:4000
DOWNSTREAM_API_KEY=development-only-key
DOWNSTREAM_TIMEOUT_MS=5000
DOWNSTREAM_CONCURRENCY=4
INBOX_POLL_INTERVAL_MS=100
INBOX_BATCH_SIZE=25
OUTBOX_POLL_INTERVAL_MS=200
OUTBOX_BATCH_SIZE=25
RETRY_BASE_DELAY_MS=1000
RETRY_MAX_DELAY_MS=60000
RETRY_JITTER_RATIO=0.2
PCM_FAILURE_THRESHOLD=3
PCM_FAILURE_WINDOW_DAYS=7
PCM_FAILURE_MIN_SPAN_HOURS=24
HTTP_BODY_LIMIT_BYTES=262144
JSON_MAX_DEPTH=32
MAX_PCM_REASONS=32
EVIDENCE_ALLOWED_BUCKETS=venue-logs
EVIDENCE_MAX_KEYS=20
EVIDENCE_MAX_KEY_BYTES=1024
HISTORY_MAX_PAGE_SIZE=100
DOWNSTREAM_ERROR_EXCERPT_BYTES=1024
SHUTDOWN_TIMEOUT_MS=10000
LOG_LEVEL=info
